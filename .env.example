# ElysianVTT 环境变量
# 复制此文件为 .env 并填入实际值

# --- 后端 ---

# 数据库连接（Prisma）
# SQLite 开发环境：file:./dev.db
# PostgreSQL 生产环境：postgresql://user:password@host:port/database
DATABASE_URL="file:./dev.db"

# 服务端口（可选，默认 3000）
# PORT=3000

# 通用本机开发服务的身份选择登录，默认关闭；生产模式始终关闭。
# 仅需要通用开发夹具时显式设置为 1；局域网 Demo 不使用此入口。
ELYSIAN_ENABLE_DEV_LOGIN=0

# CORS 允许的源（可选，默认 *）
# CORS_ORIGIN=*

# 可选：JWT 密钥（如果启用身份验证）
# JWT_SECRET=change-me-in-production
