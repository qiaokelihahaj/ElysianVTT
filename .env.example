# ElysianVTT 环境变量
# 复制此文件为 .env 并填入实际值

# --- 后端 ---

# 数据库连接（Prisma）
# SQLite 开发环境：file:./dev.db
# PostgreSQL 生产环境：postgresql://user:password@host:port/database
DATABASE_URL="file:./dev.db"

# 服务端口（可选，默认 3000）
# PORT=3000

# CORS 允许的源（可选，默认 *）
# CORS_ORIGIN=*

# 可选：JWT 密钥（如果启用身份验证）
# JWT_SECRET=change-me-in-production
