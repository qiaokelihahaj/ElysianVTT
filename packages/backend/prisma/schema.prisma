generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"  
}

// 技能/动作模板字典 (冷数据)
model ActionTemplate {
  id            String @id       // 例如: 'HEAVY_STRIKE'
  name          String           // 技能名称
  startupTicks  Int              // 前摇
  recoveryTicks Int              // 后摇
  effectsJson   String           // 核心效果数组 (JSON格式存储 ActionEffectPayload[])
  priorityExpr  String?          // 动态判定优先级公式 (ClashPool 用), 如 "actor.str + actor.reach * 2"
  sustainResourcesJson String?   // STARTUP 阶段必须维持的资源列表 JSON, 如 ["poise"]
  channelOptionsJson String?   // 持续引导/多段动作配置 JSON
  tagsJson         String? 
  resourceCostJson String?
  rangeJson        String? 
}

// 角色/怪物档案基础数据 (冷数据)
model CharacterSheet {
  id            String @id       // 例如: 'actor_warrior'
  name          String           // 角色名
  type          String           // // 'ACTOR' | 'PROP' | 'PROJECTILE'   
  resourcesJson String           // HP/MP/Poise等资源池初始设定 (JSON格式)
  currentSceneId  String? // 决定该实体当前属于哪个房间/场景
  transformJson   String  // 包含坐标、朝向、所在平面
  physicsJson     String  // 包含碰撞半径、质量等
}

model User {
  id           String   @id
  displayName  String
  loginName    String?  @unique
  passwordHash String?
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Role {
  id          String   @id
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
}

model Session {
  id           String   @id
  userId       String
  tokenVersion Int      @default(0)
  roleSnapshot String
  expiresAt    DateTime
  revokedAt    DateTime?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime?
}

model PermissionGrant {
  id              String   @id
  grantedByUserId String
  grantedToUserId String
  capability      String
  scopeType       String
  scopeId         String?
  sceneId         String?
  expiresAt       DateTime?
  revokedAt       DateTime?
  revokedByUserId String?
  reason          String?
  createdAt       DateTime @default(now())
}

model AuditEvent {
  id          String   @id
  actorUserId String
  actorRole   String
  eventType   String
  subjectType String
  subjectId   String
  sceneId     String?
  tick        Int?
  beforeJson  String?
  afterJson   String?
  reason      String?
  visibility  String
  createdAt   DateTime @default(now())
}

model DiceRoll {
  id                 String   @id
  sceneId            String?
  sourceEntityId     String?
  rolledByUserId     String?
  rollType           String
  inputExpr          String
  rawResultJson      String
  finalResultJson    String
  overrideType       String?
  overriddenByUserId String?
  overrideReason     String?
  createdAt          DateTime @default(now())
}

model LogEntry {
  id         String   @id
  sceneId    String?
  tick       Int?
  namespace  String
  level      String
  visibility String
  message    String
  metaJson   String?
  createdAt  DateTime @default(now())
}

model PermissionSnapshot {
  id                      String   @id
  sessionId               String
  userId                  String
  roleSnapshot            String
  version                 Int
  controllableEntitiesJson String
  visibleEntitiesJson     String
  capabilitiesJson        String
  currentSceneIdsJson     String
  issuedAt                DateTime @default(now())
  expiresAt               DateTime?
  refreshedAt             DateTime?
}